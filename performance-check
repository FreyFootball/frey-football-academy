<style>

/* =========================================================
   RESET
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
}

body {

    min-height: 100vh;

    color: #ffffff;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    line-height: 1.6;

    overflow-x: hidden;

    position: relative;

    background:

        radial-gradient(
            circle at 50% 5%,
            rgba(255, 122, 0, 0.24),
            transparent 32%
        ),

        radial-gradient(
            circle at 0% 55%,
            rgba(255, 122, 0, 0.07),
            transparent 30%
        ),

        radial-gradient(
            circle at 100% 80%,
            rgba(255, 122, 0, 0.06),
            transparent 30%
        ),

        linear-gradient(
            180deg,
            #181818 0%,
            #0b0b0b 55%,
            #030303 100%
        );
}


/* =========================================================
   ANIMIERTER HINTERGRUND
========================================================= */

body::before {

    content: "";

    position: fixed;

    width: 180vw;
    height: 180vw;

    top: -90vw;
    left: -40vw;

    pointer-events: none;

    background:

        conic-gradient(
            from 0deg,
            transparent 0deg,
            rgba(255, 122, 0, 0.035) 70deg,
            transparent 135deg,
            rgba(255, 255, 255, 0.018) 220deg,
            transparent 300deg
        );

    animation:
        backgroundRotate
        28s
        linear
        infinite;

    z-index: 0;
}


body::after {

    content: "";

    position: fixed;

    width: 650px;
    height: 650px;

    left: 50%;
    top: 0;

    transform:
        translate(-50%, -45%);

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(255, 122, 0, 0.15),
            transparent 68%
        );

    filter: blur(35px);

    pointer-events: none;

    animation:
        mainGlow
        5s
        ease-in-out
        infinite;

    z-index: 0;
}


@keyframes backgroundRotate {

    from {
        rotate: 0deg;
    }

    to {
        rotate: 360deg;
    }
}


@keyframes mainGlow {

    0%,
    100% {
        opacity: 0.45;
        scale: 0.92;
    }

    50% {
        opacity: 1;
        scale: 1.08;
    }
}


/* =========================================================
   PARTIKEL
========================================================= */

.particles {

    position: fixed;

    inset: 0;

    overflow: hidden;

    pointer-events: none;

    z-index: 0;
}


.particle {

    position: absolute;

    bottom: -15px;

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: #ff7a00;

    box-shadow:
        0 0 8px #ff7a00,
        0 0 18px rgba(255, 122, 0, 0.5);

    opacity: 0;

    animation:
        particleFloat
        linear
        infinite;
}


@keyframes particleFloat {

    0% {
        transform:
            translate3d(0, 0, 0)
            scale(0.4);
        opacity: 0;
    }

    10% {
        opacity: 0.5;
    }

    50% {
        opacity: 1;
    }

    90% {
        opacity: 0.3;
    }

    100% {
        transform:
            translate3d(90px, -110vh, 0)
            scale(1.2);
        opacity: 0;
    }
}


/* =========================================================
   HAUPTBEREICH
========================================================= */

.container {

    position: relative;

    z-index: 2;

    width: 92%;

    max-width: 900px;

    margin: 0 auto;

    padding:
        35px
        0
        60px;

    text-align: center;
}


/* =========================================================
   LOGO
========================================================= */

.logo-wrapper {

    position: relative;

    width: 100%;

    min-height: 190px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin:
        0
        auto
        5px;

    animation:
        logoEntrance
        0.9s
        cubic-bezier(.16,1,.3,1)
        both;
}


.logo-wrapper::before {

    content: "";

    position: absolute;

    width: 280px;
    height: 280px;

    left: 50%;
    top: 50%;

    transform:
        translate(-50%, -50%);

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(255, 122, 0, 0.22),
            transparent 65%
        );

    filter: blur(22px);

    pointer-events: none;

    z-index: -1;

    animation:
        logoGlow
        3.5s
        ease-in-out
        infinite;
}


.logo {

    display: block;

    width: 220px;

    max-width: 75%;

    height: auto;

    filter:
        drop-shadow(
            0 0 22px
            rgba(255, 122, 0, 0.25)
        );

    transition:
        transform 0.4s ease,
        filter 0.4s ease;
}


.logo:hover {

    transform:
        scale(1.06)
        rotate(-1deg);

    filter:
        drop-shadow(
            0 0 35px
            rgba(255, 122, 0, 0.55)
        );
}


@keyframes logoEntrance {

    from {
        opacity: 0;
        transform:
            translateY(-35px)
            scale(0.8);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}


@keyframes logoGlow {

    0%,
    100% {
        opacity: 0.45;
        transform:
            translate(-50%, -50%)
            scale(0.90);
    }

    50% {
        opacity: 1;
        transform:
            translate(-50%, -50%)
            scale(1.15);
    }
}


/* =========================================================
   TITEL
========================================================= */

h1 {

    margin:
        0
        auto
        12px;

    color: #ffffff;

    font-size: 46px;

    line-height: 1.05;

    font-weight: 900;

    letter-spacing: -1px;

    animation:
        fadeUp
        0.8s
        0.2s
        cubic-bezier(.16,1,.3,1)
        both;
}


.orange {
    color: #ff7a00;
}


.claim {

    margin:
        0
        auto
        45px;

    color: #ffffff;

    font-size: 21px;

    font-weight: 700;

    letter-spacing: 1px;

    text-transform: uppercase;

    animation:
        fadeUp
        0.8s
        0.35s
        cubic-bezier(.16,1,.3,1)
        both;
}


.claim span {
    color: #ff7a00;
}


/* =========================================================
   EINLEITUNG
========================================================= */

.intro-card {

    padding: 28px 30px;

    margin-bottom: 28px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.055),
            rgba(18,18,18,0.96)
        );

    border:
        1px solid
        rgba(255,255,255,0.10);

    border-radius: 20px;

    box-shadow:
        0 22px 60px
        rgba(0,0,0,0.35);

    animation:
        fadeUp
        0.8s
        0.45s
        cubic-bezier(.16,1,.3,1)
        both;
}


.intro-card p {

    margin: 0;

    color: #cfcfcf;

    font-size: 18px;

    line-height: 1.7;
}


/* =========================================================
   LEISTUNGEN
========================================================= */

.steps {

    display: grid;

    gap: 15px;

    text-align: left;

    margin-top: 25px;
}


.step {

    display: flex;

    align-items: center;

    gap: 18px;

    padding: 20px 22px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.05),
            rgba(15,15,15,0.94)
        );

    border:
        1px solid
        rgba(255,255,255,0.09);

    border-radius: 15px;

    box-shadow:
        0 14px 35px
        rgba(0,0,0,0.25);

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;

    animation:
        fadeUp
        0.8s
        cubic-bezier(.16,1,.3,1)
        both;
}


.step:nth-child(1) {
    animation-delay: 0.50s;
}

.step:nth-child(2) {
    animation-delay: 0.60s;
}

.step:nth-child(3) {
    animation-delay: 0.70s;
}

.step:nth-child(4) {
    animation-delay: 0.80s;
}

.step:nth-child(5) {
    animation-delay: 0.90s;
}


.step:hover {

    transform:
        translateX(5px);

    border-color:
        rgba(255,122,0,0.35);

    box-shadow:
        0 18px 42px
        rgba(0,0,0,0.38),

        0 0 25px
        rgba(255,122,0,0.06);
}


.step-icon {

    width: 52px;
    height: 52px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    border:
        1px solid
        rgba(255,122,0,0.65);

    border-radius: 50%;

    color: #ff7a00;

    background:
        rgba(255,122,0,0.05);

    box-shadow:
        0 0 18px
        rgba(255,122,0,0.08);
}


.step-number {

    color: #ff7a00;

    font-size: 16px;

    font-weight: 900;
}


.step-text {

    color: #ffffff;

    font-size: 17px;

    font-weight: 800;

    line-height: 1.35;
}


.step-text span {

    color: #bcbcbc;

    font-size: 14px;

    font-weight: 400;
}


/* =========================================================
   PREIS
========================================================= */

.price-box {

    position: relative;

    margin:
        38px
        auto
        0;

    max-width: 310px;

    padding:
        22px
        28px;

    border:
        2px solid
        #ff7a00;

    border-radius: 15px;

    background:
        rgba(255,122,0,0.045);

    box-shadow:
        0 0 35px
        rgba(255,122,0,0.08);

    animation:
        pricePulse
        3.5s
        ease-in-out
        infinite;
}


.price-label {

    color: #aaa;

    font-size: 14px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 1.5px;
}


.price {

    margin-top: 2px;

    color: #ff7a00;

    font-size: 58px;

    line-height: 1;

    font-weight: 900;
}


@keyframes pricePulse {

    0%,
    100% {
        transform: scale(1);
        box-shadow:
            0 0 30px
            rgba(255,122,0,0.06);
    }

    50% {
        transform: scale(1.025);
        box-shadow:
            0 0 42px
            rgba(255,122,0,0.13);
    }
}


/* =========================================================
   TAGLINE
========================================================= */

.tagline {

    margin:
        48px
        auto
        35px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 18px;

    color: #ffffff;

    font-size: 14px;

    font-weight: 700;

    letter-spacing: 5px;
}


.tagline::before,
.tagline::after {

    content: "";

    width: 75px;

    height: 2px;

    background: #ff7a00;
}


/* =========================================================
   BUTTON
========================================================= */

.back {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    padding:
        14px
        24px;

    background:
        rgba(255,255,255,0.045);

    border:
        1px solid
        rgba(255,255,255,0.10);

    color: #ddd;

    text-decoration: none;

    border-radius: 10px;

    font-weight: 700;

    transition:
        transform 0.3s ease,
        background 0.3s ease,
        border-color 0.3s ease;
}


.back:hover {

    transform:
        translateY(-3px);

    background:
        rgba(255,122,0,0.08);

    border-color:
        rgba(255,122,0,0.25);

    color: #ffffff;
}


/* =========================================================
   FOOTER
========================================================= */

.footer {

    margin-top: 42px;

    color: #666;

    font-size: 13px;

    line-height: 1.7;
}


/* =========================================================
   ANIMATION
========================================================= */

@keyframes fadeUp {

    from {
        opacity: 0;
        transform:
            translateY(22px);
    }

    to {
        opacity: 1;
        transform:
            translateY(0);
    }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .container {

        width: 94%;

        padding:
            20px
            0
            45px;
    }


    .logo-wrapper {

        min-height: 170px;
    }


    .logo {

        width: 185px;

        max-width: 78%;
    }


    .logo-wrapper::before {

        width: 240px;
        height: 240px;
    }


    h1 {

        font-size: 34px;
    }


    .claim {

        font-size: 16px;

        letter-spacing: 0.7px;

        margin-bottom: 32px;
    }


    .intro-card {

        padding: 23px 20px;
    }


    .intro-card p {

        font-size: 16px;
    }


    .step {

        padding: 17px;

        gap: 14px;
    }


    .step-icon {

        width: 46px;
        height: 46px;
    }


    .step-text {

        font-size: 15px;
    }


    .step-text span {

        font-size: 13px;
    }


    .price {

        font-size: 50px;
    }


    .tagline {

        font-size: 11px;

        letter-spacing: 3px;

        gap: 10px;
    }


    .tagline::before,
    .tagline::after {

        width: 35px;
    }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {

        animation-duration: 0.01ms !important;

        animation-iteration-count: 1 !important;

        transition-duration: 0.01ms !important;
    }

}

</style>

